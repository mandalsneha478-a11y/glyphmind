# ---------------------------------------------------------------------------
# GLYPHMIND — optional environment overrides.
# Nothing here is required: the system runs fully offline with no keys.
# Copy to .env and export before launching if you want to change defaults.
# ---------------------------------------------------------------------------

# Skip the pre-built sentence-transformers download entirely and use the
# built-in hashed n-gram encoder. Boots instantly, slightly weaker recall.
# GLYPHMIND_OFFLINE=1

# Which local embedding model to use (downloaded once, ~90 MB, then offline).
# GLYPHMIND_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional local LLM narration layer via Ollama. The grounded composer always
# produces a complete answer on its own; this only rephrases it.
#   auto   use it if an Ollama daemon is reachable   (default)
#   never  never attempt it
# GLYPHMIND_USE_LLM=auto
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Server binding
# GLYPHMIND_HOST=127.0.0.1
# GLYPHMIND_PORT=8000
